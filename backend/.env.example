# Copy to .env and adjust. NEVER commit the real .env.
ENVIRONMENT=development

# Database — SQLite for dev. For Postgres later, use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/renkkar
DATABASE_URL=sqlite+aiosqlite:///./renkkar.db

# Auth / JWT — generate a strong secret, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-insecure-secret-change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MIN=30
REFRESH_TOKEN_DAYS=7

# CORS — JSON array or comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_BIKE=8

# Set false in tests to disable rate limiting
RATE_LIMIT_ENABLED=true
